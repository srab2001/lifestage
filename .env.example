# Postgres (Neon). Omit locally to fall back to an in-memory store.
DATABASE_URL=

# Google OAuth — gates the /dashboard staff surface only. Not the
# Veteran-facing identity provider (see auth.ts).
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated allow-list of specific emails permitted into /dashboard,
# e.g. "alice@adhocteam.us,bob@va.gov". Overrides the default
# @adhocteam.us-domain check in auth.ts when set. Leave unset to keep that
# default.
ADMIN_EMAILS=
